# SchemaShield Environment Configuration Example
AWS_REGION=us-east-1
STACK_NAME=schemashield
ENVIRONMENT=development

# Frontend API URL (Set to CloudFront/API Gateway endpoint after deployment)
VITE_API_BASE_URL=http://localhost:3001/api

# DynamoDB Table Names (Configured automatically in SAM)
CONTRACTS_TABLE=schemashield-contracts
CONSUMERS_TABLE=schemashield-consumers
ANALYSES_TABLE=schemashield-analyses

# S3 Bucket Name
STORAGE_BUCKET=schemashield-storage-bucket
